{
  "name": "kaku",
  "private": true,
  "version": "0.2.0",
  "description": "AI writing actions (rewrite, correct, translate, change tone) for any desktop app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klysman08/Kaku.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "pnpm typecheck && prettier --check src && pnpm test && pnpm lint:rust && pnpm test:rust",
    "release": "node scripts/release.mjs",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.1.12",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
